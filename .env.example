# Firebase Web config del proyecto propio de Gen. Papers.
# Consíguelo en: Firebase Console -> Project settings -> Your apps -> (app web) -> SDK setup and configuration.
# Copia este archivo a .env.local y pega los valores reales (no son secretos, pero así cada quien
# apunta a su propio proyecto/entorno sin tocar el repo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para que `yarn dev` apunte al Firebase Emulator Suite local (firebase emulators:start)
# en vez del proyecto real.
VITE_USE_FIREBASE_EMULATORS=false
