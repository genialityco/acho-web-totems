rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /events/{eventSlug} {
      allow read: if true;
      allow write: if isAdmin();

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /screensaverItems/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /papers/{paperId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        // voteCount only ever changes via the castVote/resetVotes Cloud Functions
        allow update: if isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['voteCount']);
      }

      match /paperSearchIndex/{paperId} {
        allow read: if true;
        allow write: if false; // solo la Cloud Function de indexado (Admin SDK)
      }

      match /voters/{idNumber} {
        allow read, write: if isAdmin();
      }

      match /votes/{idNumber} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
