rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /events/{eventSlug} {
      allow read: if true;
      allow write: if isAdmin();

      // Legado: las categorías ahora son un campo de lista (ver fields). Se conserva la lectura
      // mientras quede desplegado el frontend anterior; borrar junto con la colección al limpiar.
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Campos (atributos) de los papers del evento, con sus opciones de lista.
      match /fields/{fieldId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /screensaverItems/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /papers/{paperId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        // voteCount/viewCount/downloadCount only ever change via Cloud Functions
        // (castVote/resetVotes and incrementPaperMetric)
        allow update: if isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['voteCount', 'viewCount', 'downloadCount']);
      }

      match /paperSearchIndex/{paperId} {
        allow read: if true;
        allow write: if false; // solo la Cloud Function de indexado (Admin SDK)
      }

      match /metricsDaily/{day} {
        allow read: if isAdmin();
        allow write: if false; // solo incrementPaperMetric / resetPaperMetrics (Admin SDK)
      }

      match /voters/{idNumber} {
        allow read, write: if isAdmin();
      }

      match /votes/{idNumber} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
