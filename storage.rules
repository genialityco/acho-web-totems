rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Custom claim (no una consulta cross-service a Firestore) para evitar depender de esa
    // integración en el camino de escritura; grantAdmin() la asigna junto con admins/{uid}.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /events/{eventSlug}/papers/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 30 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /events/{eventSlug}/images/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /events/{eventSlug}/screensaver/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 150 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow delete: if isAdmin();
    }
  }
}
