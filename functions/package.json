  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  }
}
